{
  "backupDir": "/home/ghost/backups",
  "runOnce": false,
  "initializeMode": false,
  "enableMonitoring": true,
  "monitorPaths": [
    "/home/ghost/backups",
    "/var/lib/docker/volumes"
  ],
  "diskThresholdPercent": 85.0,
  "monitorInterval": "1h",
  "backupSchedule": "0 2 * * *",
  "retentionDays": 14,
  "s3": {
    "_comment": "Use the endpoint URL provided by Cloudflare when you create an API token",
    "enabled": true,
    "endpoint": "https://your-r2-endpoint.r2.cloudflarestorage.com",
    "region": "auto",
    "bucket": "server-backups",
    "accessKey": "",
    "secretKey": "",
    "useSSL": true,
    "archiveOnly": true,
    "archiveAfterDays": 14
  },
  "webhookURLs": [],
  "webhookTimeout": "30s"
} 